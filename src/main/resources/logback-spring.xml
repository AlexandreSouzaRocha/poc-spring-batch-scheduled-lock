<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="TIMESTAMP" value="%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC}"/>
    <property name="COMMON_FIELDS" value="level=%level logger=%logger{40} thread=%thread request_id=%X{request_id:--} trace_id=%X{trace_id:--} span_id=%X{span_id:--}"/>

    <appender name="APPLICATION" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${TIMESTAMP} ${COMMON_FIELDS} %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FRAMEWORK" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${TIMESTAMP} ${COMMON_FIELDS} msg="%replace(%msg){'"','\\"'}"%replace(%ex{short}){'\n',' '}%n</pattern>
        </encoder>
    </appender>

    <logger name="br.com.spring.batch.partitioner" level="INFO" additivity="false">
        <appender-ref ref="APPLICATION"/>
    </logger>

    <logger name="br.com.spring.batch.partitioner.Application" level="INFO" additivity="false">
        <appender-ref ref="FRAMEWORK"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="FRAMEWORK"/>
    </root>

</configuration>
